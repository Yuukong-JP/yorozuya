# Application
PROJECT_NAME=KOLEGA
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database
# By default (no DATABASE_URL set) the app uses a local SQLite file
# (./kolega.db) — no Docker or PostgreSQL needed. Tables are created
# automatically on startup.
#
# To use PostgreSQL instead, uncomment and adjust:
# DATABASE_URL=postgresql+asyncpg://kolega:kolega@localhost:5432/kolega

# Security
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
